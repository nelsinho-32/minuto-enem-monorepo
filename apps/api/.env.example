# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enem_app?schema=public"

# Servidor e Rede
PORT=3333
NODE_ENV=development
TRUST_PROXY=1
JSON_BODY_LIMIT=2mb

# CORS (use * em desenvolvimento ou lista separada por vírgula em produção, ex: https://app.minutoenem.com.br,*.ngrok-free.app)
CORS_ORIGIN=*

# Autenticação JWT & WebSocket
JWT_SECRET="altere-para-um-segredo-forte-em-producao"
JWT_REFRESH_SECRET="altere-para-um-refresh-secret-forte"
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
SOCKET_ALLOW_GUEST=true

# Storage de Arquivos (local | s3 | r2 | supabase | minio)
STORAGE_PROVIDER=local
# S3_BUCKET=minuto-enem-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.minutoenem.com.br
# S3_FORCE_PATH_STYLE=true

# Rate Limiting (opcional ajustar limites)
DISABLE_RATE_LIMIT=false
# RATE_LIMIT_AUTH_MAX=25
# RATE_LIMIT_CHAT_MAX=45
# RATE_LIMIT_UPLOAD_MAX=20
# RATE_LIMIT_GENERAL_MAX=300

# Observabilidade (Opcional)
# SENTRY_DSN=
