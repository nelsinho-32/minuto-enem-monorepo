{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@minuto-enem/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@minuto-enem/shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "extrator-enem",
    "questoes"
  ],
  "extends": "expo/tsconfig.base"
}
